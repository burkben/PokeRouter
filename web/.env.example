# Backend base URL used by the web app.
# In dev this is unset — Vite proxies /api -> http://localhost:8080 (see vite.config.ts).
# For a production build, point this at your deployed backend origin, e.g.:
# VITE_API_BASE=https://api.pokerouter.example.com
#
# Override the dev proxy target (defaults to http://localhost:8080):
# BACKEND_URL=http://localhost:8080
