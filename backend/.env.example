# Optional — only needed for `npm run load:db`.
DATABASE_URL=postgres://pokerouter:pokerouter@localhost:5432/pokerouter

# Data source: "bulk" (default, one request to the community mirror),
# "api" (adaptive quadtree sweep of the official locator API; WAF rate-limited),
# or "seed" (read the committed data/seed/machines.json snapshot; offline).
# HARVEST_SOURCE=bulk
# BULK_API_URL=https://pkmnvm.com/api/locations
# SEED_PATH=./data/seed/machines.json

# Official-API sweep tuning (only used when HARVEST_SOURCE=api; defaults shown).
# HARVEST_CONCURRENCY=2
# HARVEST_REQUEST_DELAY_MS=300
# HARVEST_MIN_SPAN=0.02
# HARVEST_MAX_DEPTH=16
# HARVEST_OUT=./data/machines.json
# VENDING_API_BASE=https://api.vending.prod.pokemon.com/v1/machines
