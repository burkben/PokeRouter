# Optional — only needed for `npm run load:db`.
DATABASE_URL=postgres://pokerouter:pokerouter@localhost:5432/pokerouter

# Data source: "bulk" (default, one request to the community mirror),
# "api" (adaptive quadtree sweep of the official locator API; WAF rate-limited),
# or "seed" (read the committed data/seed/machines.json snapshot; offline).
# HARVEST_SOURCE=bulk
# BULK_API_URL=https://pkmnvm.com/api/locations
# SEED_PATH=./data/seed/machines.json

# Official-API sweep tuning (only used when HARVEST_SOURCE=api; defaults shown).
# HARVEST_CONCURRENCY=2
# HARVEST_REQUEST_DELAY_MS=300
# HARVEST_MIN_SPAN=0.02
# HARVEST_MAX_DEPTH=16
# HARVEST_OUT=./data/machines.json
# VENDING_API_BASE=https://api.vending.prod.pokemon.com/v1/machines

# P1 API server.
# PORT=8080
# HOST=0.0.0.0

# Routing: set ORS_API_KEY for real road routes (free key from
# https://openrouteservice.org). Unset → offline straight-line stub.
# ORS_API_KEY=
# ORS_PROFILE=driving-car
# ORS_BASE_URL=https://api.openrouteservice.org

# Tesla "send to car" (P4). Three modes, resolved automatically:
#
#   1. DEMO  — set TESLA_MOCK=1 for a fully offline mock (canned vehicles, no
#              Tesla account, nothing leaves your machine). Great for trying the
#              flow. Takes precedence over live credentials below.
#   2. LIVE  — set CLIENT_ID + CLIENT_SECRET + REDIRECT_URI (all three) to use
#              the real Fleet API. Requires a Tesla developer app + a publicly
#              hosted domain serving the .well-known public key (see README).
#   3. OFF   — none of the above set → the Tesla panel is hidden in the UI and
#              the endpoints report "disabled".
#
# TESLA_MOCK=1
# TESLA_CLIENT_ID=
# TESLA_CLIENT_SECRET=
# TESLA_REDIRECT_URI=http://localhost:8080/tesla/auth/callback
# Where to bounce the browser back to after the OAuth dance (the web app).
# TESLA_WEB_RETURN_URL=http://localhost:5173
# Region Fleet API base (default is North America).
# TESLA_AUDIENCE=https://fleet-api.prd.na.vn.cloud.tesla.com
# TESLA_AUTH_URL=https://auth.tesla.com
# TESLA_SCOPES=openid offline_access vehicle_device_data vehicle_cmds vehicle_location
# Persist the connected user's tokens across restarts (git-ignored).
# TESLA_TOKEN_FILE=./data/tesla-tokens.json
# Public key for Fleet API domain registration (inline PEM or a file path).
# TESLA_PUBLIC_KEY_PEM_PATH=./data/com.tesla.3p.public-key.pem

