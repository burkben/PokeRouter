{
  "name": "pokerouter-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PokeRouter backend — vending machine data harvester and (later) corridor routing API.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "harvest": "tsx src/harvester/harvest.ts",
    "load:db": "tsx src/db/load.ts",
    "dev": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "fastify": "^5.2.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
